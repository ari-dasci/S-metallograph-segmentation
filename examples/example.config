# Example configuration for the training scripts under metallograph_segmentation/models/.
#
# Every key below is read by the training scripts (models/sm/train.py and
# models/multiview/train.py); the README explains what each one controls. The values are
# placeholders: `datadir` must point at a directory holding the MetalDAM .h5 files, which
# are not distributed with this repository.
#
# The parser is metallograph_segmentation/utils/config.py. Typed sections matter: numbers
# read from [int] and [float] sections are converted, and only [bool]/[boolean] sections are
# read as booleans.

[general]
# Dataset family to load (uhcs, arcelor, ...).
dataset = uhcs
# Directory containing the .h5 files.
datadir = data
# Where checkpoints and results are written.
modeldir = experiments
# Name of this run.
name = example_unet

[str]
# Colour space expected by the model family.
colors = rgb

[int]
num_classes = 4
kfold = 3
kernel_size = 3

[float]
validation_ratio = 0.2

[bool]
debug = False
run_cv = True
run_test = True
